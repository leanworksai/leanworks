# Exclude sensitive files from Docker image
gcp_credential.json
*.json
.env
.env.local

# Exclude development files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Exclude IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Exclude git files
.git/
.gitignore
.gitattributes

# Exclude test files
tests/
*.test.py
test_*.py
*_test.py

# Exclude documentation
*.md
docs/
README*

# Exclude deployment scripts (not needed in image)
deploy/

# Exclude CI/CD files
.github/
.gitlab-ci.yml
.travis.yml

# Exclude large data files
*.pkl
*.model
*.bin
*.h5
*.onnx
*.pt
*.pth
*.data
*.db
*.sqlite
*.sqlite3

# Exclude logs
*.log
logs/
